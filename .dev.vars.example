# Copy to `.dev.vars` and fill in. Wrangler loads that file for `next dev`
# and for the local Worker; it is gitignored, this template is not.
#
# Everything here is a *secret*. The non-secret configuration — ADMIN_HOST,
# PUBLIC_HOST, SESSION_COOKIE_DOMAIN — lives in wrangler.jsonc and needs no
# local override: those vars do reach `next dev`, but both places that read
# them derive their behaviour from the request's own host, so a loopback dev
# server neutralises them by itself. See src/lib/host-routing.ts and
# sessionCookieDomain() in src/lib/session-token.ts.

# Signs the session JWT. Any long random string locally; in production set it
# with `wrangler secret put JWT_SECRET`.
JWT_SECRET=

# Comma-separated allowlist of addresses that get ADMIN on login. Admin rights
# come ONLY from this list, never from the address itself.
# The e2e suite reads the first entry here to log into the console
# (readConfiguredAdminEmail in e2e/helpers/otp.ts), so it must be set before
# `npm run test:e2e`.
ADMIN_EMAILS=

# Shared secret for POST /api/cron/pricing-refresh (daily due-check).
CRON_SECRET=

# SePay (VN) and Paddle (international) credentials are NOT Worker secrets.
# Enter them in Admin → Cấu hình Thanh toán. They live in `app_settings` so
# they can change without a deploy. The public `/api/settings/payment`
# endpoint never returns the API keys or webhook secrets.
